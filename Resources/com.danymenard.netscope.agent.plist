<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Note 64 : agent sans fenêtre de NetScope, enregistré par l'app (SMAppService, Réglages ›
     Surveillance), désactivé par défaut. Copié par build.sh dans Contents/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.danymenard.netscope.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/NetScopeAgent</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.danymenard.netscope</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
